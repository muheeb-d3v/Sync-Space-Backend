# SyncSpace backend - production
# Copy to backend/.env.production, or set these values in your hosting provider.
# Never commit the real file.
PORT=3000
NODE_ENV=production

# MongoDB Atlas production connection string
PROD_DB_URL=mongodb+srv://username:password@cluster.mongodb.net/syncspace

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_TIME=1d

# Mail
MAIL_ID=your-mail@example.com
MAIL_PASSWORD=your-app-password

# Redis (optional; used by the mail queue). Use a managed Redis URL.
REDIS_URL=

# Your deployed frontend origin(s), comma separated
CLIENT_ORIGIN=https://your-frontend-domain.com
